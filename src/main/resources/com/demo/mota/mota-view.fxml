<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Pos?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<!-- 自下而上两层：游戏画面 → 其余全部界面（加载 / 标题 / 游戏菜单 / 物品栏 / 装备 / 技能设置 / 结束） -->
<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.demo.mota.MotaController"
           stylesheets="@mota-style.css"
           alignment="TOP_LEFT">

    <HBox fx:id="gameBox" spacing="0">
        <!-- 左侧：玩家状态面板（Canvas绘制） -->
        <Canvas fx:id="statusCanvas" width="208" height="832"/>

        <!-- 中间：地图画布 -->
        <Canvas fx:id="mapCanvas" width="832" height="832"/>

        <!-- 右侧：技能 / 装备栏（分区由 gameRules.json 的 sidePanel.sections 决定） -->
        <Canvas fx:id="sideCanvas" width="256" height="832"/>
    </HBox>

    <!-- 最外层界面：多数铺满整屏；游戏结束只画底部提示框、其余部分透出游戏画面（Screen.overlaysGame） -->
    <Canvas fx:id="screenCanvas" width="1296" height="840"/>

</StackPane>
