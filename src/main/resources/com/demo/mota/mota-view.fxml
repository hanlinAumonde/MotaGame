<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Pos?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<!-- 自下而上三层：游戏画面 → 游戏内菜单 → 标题/加载/结束界面 -->
<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.demo.mota.MotaController"
           stylesheets="@mota-style.css"
           alignment="TOP_LEFT">

    <HBox fx:id="gameBox" spacing="0">
        <!-- 左侧：玩家状态面板（Canvas绘制） -->
        <Canvas fx:id="statusCanvas" width="208" height="832"/>

        <!-- 右侧：地图画布 -->
        <Canvas fx:id="mapCanvas" width="832" height="832"/>
    </HBox>

    <!-- 游戏内菜单（按 X 呼出），整屏覆盖 -->
    <Canvas fx:id="menuCanvas" width="1040" height="840" visible="false"/>

    <!-- 最外层界面：加载 / 标题铺满整屏，游戏结束只画底部提示框、其余部分透出游戏画面 -->
    <Canvas fx:id="screenCanvas" width="1040" height="840"/>

</StackPane>
